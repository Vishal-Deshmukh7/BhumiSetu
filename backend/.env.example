GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Comma-separated fallback models tried after quota, availability, or transient API errors.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-pro-preview,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite
PORT=5001
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
LANDOWNER_OPENROUTER_API_KEY=your_landowner_openrouter_api_key_here
LANDOWNER_OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,inclusionai/ling-3.0-flash-vl:free
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=land_acquisition
